# .snyk
version: v1.25.0
ignore:
  # Ignore zlib vulnerability (Debian Bookworm)
  SNYK-DEBIAN12-ZLIB-6008963:
    - '* > zlib/zlib1g'
    - '* > util-linux > zlib/zlib1g'
    - '* > apt > libapt-pkg6.0 > zlib/zlib1g'
    reason: 'Debian 12 bookworm has patched zlib1g (1:1.2.13.dfsg-1+deb12u1)'
    expires: 2024-08-31T00:00:00.000Z

  # Ignore Keras vulnerability (false positive for TF 2.16.1)
  SNYK-PYTHON-KERAS-9396793:
    - '* > tensorflow-cpu > keras'
    reason: 'TensorFlow 2.16.1 bundles a patched Keras 3.0.5'
    expires: 2024-08-31T00:00:00.000Z